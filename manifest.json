  {
    "guid": "5d0a3a1e-2e48-4358-b9a5-5942845aedb4",
    "name": "Companions",
    "description": "Links movies and series to their soundtrack in your music library and to the book or audiobook in Audiobookshelf, Kavita, Grimmory or BookOrbit.",
    "overview": "Soundtracks, books and audiobooks for your movies",
    "owner": "skriewel",
    "category": "General",
    "imageUrl": "https://raw.githubusercontent.com/skriewel/jellyfin-companions/main/images/logo.png",
    "versions": [
      {
        "version": "1.0.7.0",
        "changelog": "Books: volume numbers written as v03 or Vol3 are recognised (e.g. Witch Hat Atelier v03 (2019) (Digital)), so such volumes match their series.",
        "targetAbi": "12.0.0.0",
        "sourceUrl": "https://github.com/skriewel/jellyfin-companions/releases/download/v1.0.7.0/Companions_1.0.7.0.zip",
        "checksum": "c9b0e453289db35e403315002b5ba30c",
        "timestamp": "2026-11-08T17:09:28Z"
      },
      {
        "version": "1.0.6.0",
        "changelog": "Books: titles are looked up in several languages (default en, de) so German editions are found too; Explain lists the search words and the books a server found that were not linked, with the reason.",
        "targetAbi": "12.0.0.0",
        "sourceUrl": "https://github.com/skriewel/jellyfin-companions/releases/download/v1.0.6.0/Companions_1.0.6.0.zip",
        "checksum": "f9aff1d9750b376d833059da8853f9be",
        "timestamp": "2026-11-08T17:05:29Z"
      },
      {
        "version": "1.0.5.0",
        "changelog": "Books: the English title is looked up through Jellyfin's TMDB provider and searched too (Atelier of Witch Hat -> Witch Hat Atelier); volume numbers are ignored when comparing titles; more than four volumes of one series on one server are shown as one card with the number of volumes.",
        "targetAbi": "12.0.0.0",
        "sourceUrl": "https://github.com/skriewel/jellyfin-companions/releases/download/v1.0.5.0/Companions_1.0.5.0.zip",
        "checksum": "f960b37e2e57a0e191a47b4f3e3a2456",
        "timestamp": "2026-11-08T15:25:06Z"
      },
      {
        "version": "1.0.4.0",
        "changelog": "Books: a book also matches through its book series (Silo -> Wool, Shift, Dust) in Audiobookshelf, Grimmory and BookOrbit; books of a series are listed in series order.",
        "targetAbi": "12.0.0.0",
        "sourceUrl": "https://github.com/skriewel/jellyfin-companions/releases/download/v1.0.4.0/Companions_1.0.4.0.zip",
        "checksum": "e6ad1734927a4aa0b4862f0abcac0e46",
        "timestamp": "2026-11-08T15:18:10Z"
      },
      {
        "version": "1.0.3.0",
        "changelog": "Books: titles are also searched without a leading number or article (3 Body Problem -> Body Problem), so book servers that search literally find The Three-Body Problem even when Jellyfin knows no source author.",
        "targetAbi": "12.0.0.0",
        "sourceUrl": "https://github.com/skriewel/jellyfin-companions/releases/download/v1.0.3.0/Companions_1.0.3.0.zip",
        "checksum": "fff1258a697c38239b50def6ba9b1afb",
        "timestamp": "2026-11-08T14:50:51Z"
      },
      {
        "version": "1.0.2.0",
        "changelog": "Books: authors match in any name order (Liu Cixin = Cixin Liu), numbers match their words (3 Body Problem = The Three-Body Problem), and titles with a number are also searched with the number spelled out.",
        "targetAbi": "12.0.0.0",
        "sourceUrl": "https://github.com/skriewel/jellyfin-companions/releases/download/v1.0.2.0/Companions_1.0.2.0.zip",
        "checksum": "427c6896919aa505c26887c8a70ca968",
        "timestamp": "2026-11-08T14:40:06Z"
      },
      {
        "version": "1.0.1.0",
        "changelog": "Audiobookshelf covers: falls back to the original image when resizing fails and accepts covers without a content type; failures are logged and shown by Explain. The book row is no longer a Jellyfin item row, so other plugins do not add their cards to it.",
        "targetAbi": "12.0.0.0",
        "sourceUrl": "https://github.com/skriewel/jellyfin-companions/releases/download/v1.0.1.0/Companions_1.0.1.0.zip",
        "checksum": "c38b6243ae3f4c182107652f52358667",
        "timestamp": "2026-11-08T14:17:45Z"
      },
      {
        "version": "1.0.0.0",
        "changelog": "First release: soundtracks from the music library, books and audiobooks from Audiobookshelf, Kavita, Grimmory and BookOrbit",
        "targetAbi": "12.0.0.0",
        "sourceUrl": "https://github.com/skriewel/jellyfin-companions/releases/download/v1.0.0.0/Companions_1.0.0.0.zip",
